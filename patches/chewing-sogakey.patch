+// SogaKey: a remembered space is the first tone, everything else a normal key.
+static void feedKey(ChewingContext *c, char key) {
+    if (key == ' ') {
+        chewing_handle_Space(c);
+    } else {
+        chewing_handle_Default(c, static_cast<unsigned char>(key));
