         std::make_unique<ChewingCandidateList>(this, ic));
     if (ic->inputPanel().candidateList()->empty()) {
         ic->inputPanel().setCandidateList(nullptr);
+        // SogaKey: no selection window open -> show live candidates for the
+        // phrase before the cursor
+        auto *ctx = context_.get();
+        if (chewing_buffer_Len(ctx) > 0 && chewing_cand_open(ctx) == 0) {
+            auto live = std::make_unique<CommonCandidateList>();
+            live->setPageSize(10);
+            chewing_cand_Enumerate(ctx);
+            int index = 0;
+            while (chewing_cand_hasNext(ctx) && index < 50) {
+                live->append<LiveCandidateWord>(
+                    this, chewing_cand_String_static(ctx), index);
+                index++;
+            }
+            chewing_cand_close(ctx);
+            if (!live->empty()) {
+                live->setGlobalCursorIndex(0);
+                ic->inputPanel().setCandidateList(std::move(live));
+            }
+        }
     }
 
     updatePreedit(ic);
