+// SogaKey: re-type the remembered keys into the shadow context and report
+// whether it reaches exactly the same state as the real context.
+bool ChewingEngine::replayMatches(const std::string &keys) {
+    auto *s = shadow_.get();
+    chewing_cand_close(s);
+    chewing_clean_preedit_buf(s);
+    chewing_clean_bopomofo_buf(s);
+    chewing_Reset(s);
+    for (char c : keys) {
+        chewing_handle_Default(s, static_cast<unsigned char>(c));
+    }
+    auto *ctx = context_.get();
+    return safeChewing_buffer_String(s) == safeChewing_buffer_String(ctx) &&
+           safeChewing_bopomofo_String(s) == safeChewing_bopomofo_String(ctx) &&
+           chewing_cursor_Current(s) == chewing_cursor_Current(ctx);
+}
+
+void ChewingEngine::syncTyped(int key) {
+    auto *ctx = context_.get();
+    if (safeChewing_buffer_String(ctx).empty() &&
+        safeChewing_bopomofo_String(ctx).empty()) {
+        clearTyped();
+        return;
+    }
+    if (!shadow_) {
+        shadow_.reset(getChewingContext());
+        applyConfig(shadow_.get(), true);
+    }
+    if (!typedValid_) {
+        return;
+    }
+    std::string keys = typed_;
+    if (key >= 0) {
+        keys.push_back(static_cast<char>(key));
+    }
+    // Backspace may remove a whole syllable: try shorter histories as well.
+    for (size_t drop = 0; drop <= 4 && drop <= keys.size(); ++drop) {
+        std::string candidate = keys.substr(0, keys.size() - drop);
+        if (replayMatches(candidate)) {
+            typed_ = std::move(candidate);
+            return;
+        }
+    }
+    typedValid_ = false;
+}
+
+// SogaKey: put the typed keys into the shadow context, followed by a dummy
+// initial so that the fuzzy engine counts the unfinished last syllable as part
+// of the phrase. Afterwards candidates can be opened on the shadow context.
+bool ChewingEngine::prepareShadow() {
+    if (!typedValid_ || typed_.empty() || !shadow_) {
+        return false;
+    }
+    if (!replayMatches(typed_)) {
+        typedValid_ = false;
+        return false;
+    }
+    auto *s = shadow_.get();
+    chewing_handle_Default(s, 'z');
+    return chewing_buffer_Len(s) > 0;
+}
+
+void ChewingEngine::finishLive(InputContext *ic, const std::string &text) {
+    if (!text.empty()) {
+        ic->commitString(text);
+    }
+    auto *ctx = context_.get();
+    chewing_cand_close(ctx);
+    chewing_clean_preedit_buf(ctx);
+    chewing_clean_bopomofo_buf(ctx);
+    chewing_Reset(ctx);
+    clearTyped();
+    updateUI(ic);
+}
+
+void ChewingEngine::commitLive(InputContext *ic, int index) {
+    if (!prepareShadow()) {
+        return;
+    }
+    auto *s = shadow_.get();
+    if (chewing_cand_open(s) != 0) {
+        return;
+    }
+    chewing_cand_choose_by_index(s, index);
+    chewing_cand_close(s);
+    chewing_clean_bopomofo_buf(s);
+    std::string text;
+    if (chewing_commit_preedit_buf(s) == 0) {
+        text = safeChewing_commit_String(s);
+    }
+    chewing_ack(s);
+    finishLive(ic, text);
+}
+
+void ChewingEngine::commitBest(InputContext *ic) {
+    if (!prepareShadow()) {
+        return;
+    }
+    auto *s = shadow_.get();
+    chewing_clean_bopomofo_buf(s);
+    std::string text;
+    if (chewing_commit_preedit_buf(s) == 0) {
+        text = safeChewing_commit_String(s);
+    }
+    chewing_ack(s);
+    finishLive(ic, text);
 }
 
