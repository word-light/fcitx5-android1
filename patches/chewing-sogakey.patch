+// SogaKey: Space typed as the first tone. Fuzzy mode cannot tell it from "no
+// tone typed yet", so ask a plain (exact) context which characters really read
+// as the last typed syllable with the first tone.
+static std::string lastUtf8Char(const std::string &text) {
+    size_t i = text.size();
+    while (i > 0 && (static_cast<unsigned char>(text[i - 1]) & 0xC0) == 0x80) {
+        --i;
+    }
+    return i > 0 ? text.substr(i - 1) : std::string();
+}
+
+std::vector<std::string> ChewingEngine::exactToneOne() {
+    std::vector<std::string> result;
+    if (typed_.empty() || typed_.back() != ' ' || !shadow_) {
+        return result;
+    }
+    auto *s = shadow_.get();
+    replayRaw(typed_);
+    if (chewing_bopomofo_Check(s) != 0) {
+        return result;
+    }
+    int len = chewing_get_phoneSeqLen(s);
+    if (len < 1) {
+        return result;
+    }
+    unsigned short *seq = chewing_get_phoneSeq(s);
+    if (!seq) {
+        return result;
+    }
+    unsigned short last = seq[len - 1];
+    chewing_free(seq);
+    char buf[64] = {0};
+    if (chewing_phone_to_bopomofo(last, buf, sizeof(buf)) < 0) {
+        return result;
+    }
+    static const char kKeys[] = "1qaz2wsxedcrfv5tgbyhnujm8ik,9ol.0p;/-";
+    static const char *const kZy[] = {
+        "ㄅ", "ㄆ", "ㄇ", "ㄈ", "ㄉ", "ㄊ", "ㄋ", "ㄌ", "ㄍ", "ㄎ", "ㄏ", "ㄐ", "ㄑ",
+        "ㄒ", "ㄓ", "ㄔ", "ㄕ", "ㄖ", "ㄗ", "ㄘ", "ㄙ", "ㄧ", "ㄨ", "ㄩ", "ㄚ", "ㄛ",
+        "ㄜ", "ㄝ", "ㄞ", "ㄟ", "ㄠ", "ㄡ", "ㄢ", "ㄣ", "ㄤ", "ㄥ", "ㄦ"};
+    std::string keys;
+    for (const char *p = buf; *p;) {
+        bool matched = false;
+        for (size_t i = 0; i < sizeof(kZy) / sizeof(kZy[0]); ++i) {
+            const size_t l = std::char_traits<char>::length(kZy[i]);
+            if (std::char_traits<char>::compare(p, kZy[i], l) == 0) {
+                keys.push_back(kKeys[i]);
+                p += l;
+                matched = true;
+                break;
+            }
+        }
+        if (!matched) {
+            return result; // carries a tone mark or something unknown
+        }
+    }
+    if (keys.empty()) {
+        return result;
+    }
+    keys.push_back(' ');
+    if (!exact_) {
+        exact_.reset(getChewingContext());
+        applyConfig(exact_.get(), true);
+        chewing_config_set_int(exact_.get(), "chewing.conversion_engine",
+                               CHEWING_CONVERSION_ENGINE);
+    }
+    auto *e = exact_.get();
+    chewing_cand_close(e);
+    chewing_clean_preedit_buf(e);
+    chewing_clean_bopomofo_buf(e);
+    chewing_Reset(e);
+    for (char c : keys) {
+        feedKey(e, c);
+    }
+    if (chewing_cand_open(e) == 0) {
+        chewing_cand_Enumerate(e);
+        int count = 0;
+        while (chewing_cand_hasNext(e) && count < 3000) {
+            std::string cand = chewing_cand_String_static(e);
+            ++count;
+            if (utf8::length(cand) == 1) {
+                result.push_back(std::move(cand));
+            }
+        }
+        chewing_cand_close(e);
+    }
+    chewing_clean_preedit_buf(e);
+    chewing_clean_bopomofo_buf(e);
+    chewing_Reset(e);
+    return result;
+}
