+std::unique_ptr<CommonCandidateList> ChewingEngine::buildLiveList() {
+    if (!typedValid_ || typed_.empty() || !shadow_) {
+        return nullptr;
+    }
+    auto *s = shadow_.get();
+    const size_t n = typed_.size();
+    // number of syllables after the first j keys (with a dummy initial)
+    std::vector<int> lens(n + 1, 0);
+    std::map<int, size_t> lastKeys;
+    // only the first ~24 keys (about 8 syllables) get their own candidates
+    const size_t maxKeys = std::min<size_t>(n, 24);
+    for (size_t j = 1; j <= maxKeys; ++j) {
+        replayRaw(typed_.substr(0, j));
+        chewing_handle_Default(s, 'z');
+        lens[j] = chewing_buffer_Len(s);
+        if (lens[j] > 0) {
+            lastKeys[lens[j]] = j;
+        }
+    }
+    auto live = std::make_unique<CommonCandidateList>();
+    live->setPageSize(10);
+    // characters that really are the typed syllable with tone 1 (Space)
+    const std::vector<std::string> toneOne = exactToneOne();
+    const std::unordered_set<std::string> toneOneSet(toneOne.begin(),
+                                                     toneOne.end());
+    std::vector<std::string> seen;
+    auto add = [&](std::string text, size_t keys) {
+        if (std::find(seen.begin(), seen.end(), text) != seen.end()) {
+            return;
+        }
+        seen.push_back(text);
+        live->append<SegCandidateWord>(this, std::move(text), keys);
+    };
+    // phrases the user chose before (whole input)
+    for (const auto &text : learnedFor(typed_)) {
+        if (std::find(seen.begin(), seen.end(), text) == seen.end()) {
+            seen.push_back(text);
+            live->append<LearnedCandidateWord>(this, text);
+        }
+    }
+    // longest coverage first
+    for (auto it = lastKeys.rbegin(); it != lastKeys.rend(); ++it) {
+        const int len = it->first;
+        const size_t keys = it->second;
+        replayRaw(typed_.substr(0, keys));
+        chewing_handle_Default(s, 'z');
+        if (keys == n) {
+            // the engine's own best guess for everything typed
+            std::string guess = safeChewing_buffer_String(s);
+            if (!guess.empty() && static_cast<int>(utf8::length(guess)) == len &&
+                (toneOneSet.empty() ||
+                 toneOneSet.count(lastUtf8Char(guess)) > 0)) {
+                add(guess, keys);
+            }
+            // a single character with tone 1: list exactly those characters
+            // first (the fuzzy list would bury them among all tones)
+            if (len == 1 && !toneOne.empty()) {
+                std::vector<std::pair<int, std::string>> exactLevel;
+                for (const auto &c : toneOne) {
+                    exactLevel.emplace_back(freqOf(c), c);
+                }
+                std::stable_sort(exactLevel.begin(), exactLevel.end(),
+                                 [](const auto &x, const auto &y) {
+                                     return x.first > y.first;
+                                 });
+                for (auto &entry : exactLevel) {
+                    add(std::move(entry.second), keys);
+                }
+            }
+        }
+        if (chewing_cand_open(s) != 0) {
+            continue;
+        }
+        chewing_cand_Enumerate(s);
+        int count = 0;
+        std::vector<std::pair<int, std::string>> level;
+        while (chewing_cand_hasNext(s) && count < 1500) {
+            std::string cand = chewing_cand_String_static(s);
+            count++;
+            if (static_cast<int>(utf8::length(cand)) == len) {
+                int f = freqOf(cand);
+                level.emplace_back(f, std::move(cand));
+            }
+        }
+        chewing_cand_close(s);
+        // known common words first (by frequency), the rest keep chewing's order
+        std::stable_sort(level.begin(), level.end(),
+                         [](const auto &x, const auto &y) {
+                             return x.first > y.first;
+                         });
+        if (keys == n && !toneOneSet.empty()) {
+            // phrases ending in the typed tone-1 syllable first
+            std::stable_partition(level.begin(), level.end(),
+                                  [&](const auto &entry) {
+                                      return toneOneSet.count(
+                                                 lastUtf8Char(entry.second)) > 0;
+                                  });
+        }
+        for (auto &entry : level) {
+            add(std::move(entry.second), keys);
+        }
+    }
+    if (live->empty()) {
+        return nullptr;
+    }
+    return live;
+}
+
+void ChewingEngine::commitLearned(InputContext *ic, const std::string &text) {
+    learn(typed_, text);
+    finishLive(ic, text);
+}
+
+void ChewingEngine::finishLive(InputContext *ic, const std::string &text) {
+    if (!text.empty()) {
+        ic->commitString(text);
+    }
+    auto *ctx = context_.get();
+    chewing_cand_close(ctx);
+    chewing_clean_preedit_buf(ctx);
+    chewing_clean_bopomofo_buf(ctx);
+    chewing_Reset(ctx);
+    clearTyped();
+    updateUI(ic);
+}
+
+void ChewingEngine::commitLive(InputContext *ic, int index) {
+    if (!prepareShadow()) {
+        return;
+    }
+    auto *s = shadow_.get();
+    if (chewing_cand_open(s) != 0) {
+        return;
+    }
+    chewing_cand_choose_by_index(s, index);
+    chewing_cand_close(s);
+    chewing_clean_bopomofo_buf(s);
+    std::string text;
+    if (chewing_commit_preedit_buf(s) == 0) {
+        text = safeChewing_commit_String(s);
+    }
+    chewing_ack(s);
+    learn(typed_, text);
+    finishLive(ic, text);
+}
+
+void ChewingEngine::commitBest(InputContext *ic) {
+    if (!prepareShadow()) {
+        return;
+    }
+    auto *s = shadow_.get();
+    chewing_clean_bopomofo_buf(s);
+    std::string text;
+    if (chewing_commit_preedit_buf(s) == 0) {
+        text = safeChewing_commit_String(s);
+    }
+    chewing_ack(s);
+    learn(typed_, text);
+    finishLive(ic, text);
 }
 
