+static std::filesystem::path learnedPath() {
+    return StandardPaths::global().userDirectory(StandardPathsType::PkgData) /
+           "chewing-sogakey-learned.tsv";
+}
+
+// SogaKey: modern word frequencies (bundled list) to rank candidates.
+void ChewingEngine::loadFreq() {
+    if (freqLoaded_) {
+        return;
+    }
+    freqLoaded_ = true;
+    auto path = StandardPaths::global().locate(
+        StandardPathsType::Data, "libchewing/sogakey-freq.tsv");
+    if (path.empty()) {
+        return;
+    }
+    std::ifstream in(path);
+    std::string line;
+    while (std::getline(in, line)) {
+        auto tab = line.find('\t');
+        if (tab == std::string::npos) {
+            continue;
+        }
+        freq_[line.substr(0, tab)] = std::atoi(line.c_str() + tab + 1);
+    }
+}
+
+int ChewingEngine::freqOf(const std::string &word) {
+    loadFreq();
+    auto it = freq_.find(word);
+    return it == freq_.end() ? 0 : it->second;
+}
+
+void ChewingEngine::loadLearned() {
+    if (learnedLoaded_) {
+        return;
+    }
+    learnedLoaded_ = true;
+    std::ifstream in(learnedPath());
+    std::string line;
+    while (std::getline(in, line)) {
+        auto a = line.find('\t');
+        auto b = line.rfind('\t');
+        if (a == std::string::npos || a == b) {
+            continue;
+        }
+        int count = std::atoi(line.c_str() + b + 1);
+        if (count > 0) {
+            learned_[line.substr(0, a)][line.substr(a + 1, b - a - 1)] = count;
+        }
+    }
+}
+
+void ChewingEngine::saveLearned() {
+    std::error_code ec;
+    auto path = learnedPath();
+    std::filesystem::create_directories(path.parent_path(), ec);
+    std::ofstream out(path, std::ios::trunc);
+    for (const auto &[key, texts] : learned_) {
+        for (const auto &[text, count] : texts) {
+            out << key << '\t' << text << '\t' << count << '\n';
+        }
+    }
+}
+
+void ChewingEngine::learn(const std::string &typed, const std::string &text) {
+    if (typed.empty() || text.empty()) {
+        return;
+    }
+    loadLearned();
+    learned_[typed][text] += 1;
+    saveLearned();
+}
+
+std::vector<std::string> ChewingEngine::learnedFor(const std::string &typed) {
+    loadLearned();
+    std::vector<std::pair<int, std::string>> found;
+    for (const auto &[key, texts] : learned_) {
+        if (key.compare(0, typed.size(), typed) != 0) {
+            continue;
+        }
+        // exact key matches count double
+        int bonus = key.size() == typed.size() ? 2 : 1;
+        for (const auto &[text, count] : texts) {
+            found.emplace_back(count * bonus, text);
+        }
+    }
+    std::stable_sort(found.begin(), found.end(),
+                     [](const auto &x, const auto &y) { return x.first > y.first; });
+    std::vector<std::string> result;
+    for (auto &f : found) {
+        if (std::find(result.begin(), result.end(), f.second) == result.end()) {
+            result.push_back(std::move(f.second));
+        }
+        if (result.size() >= 20) {
+            break;
+        }
+    }
+    return result;
+}
+
+void ChewingEngine::commitSeg(InputContext *ic, const std::string &text,
+                              size_t keys) {
+    std::string consumed = typed_.substr(0, keys);
+    std::string rest = typed_.substr(std::min(keys, typed_.size()));
+    learn(consumed, text);
+    if (!text.empty()) {
+        ic->commitString(text);
+    }
+    auto *ctx = context_.get();
+    chewing_cand_close(ctx);
+    chewing_clean_preedit_buf(ctx);
+    chewing_clean_bopomofo_buf(ctx);
+    chewing_Reset(ctx);
+    clearTyped();
+    for (char c : rest) {
+        feedKey(ctx, c);
+    }
+    if (!safeChewing_buffer_String(ctx).empty() ||
+        !safeChewing_bopomofo_String(ctx).empty()) {
+        typed_ = rest;
+    }
+    updateUI(ic);
+}
